FINERACT_IMAGE=apache/fineract@sha256:ab9f271fb27f445ac0622fbdae00c84e0780f957adc1bba356925b0e3b26a38d
POSTGRES_ADMIN_PASSWORD=replace_with_secure_password
FINERACT_DB_PASSWORD=replace_with_secure_password
FINERACT_MASTER_PASSWORD=replace_with_secure_password

# Python-owned database; never point at either Fineract database.
DATABASE_URL=postgresql+psycopg://bank_agent:replace_with_separate_password@127.0.0.1:5432/bank_agent
ENVIRONMENT=development
OTP_SECRET=replace_with_random_secret_at_least_32_characters
DEV_OTP_INBOX=true
# Local demo login credentials, minimum 12 characters. No committed defaults.
DEMO_PASSWORD=replace_with_random_demo_password
ADMIN_PASSWORD=replace_with_random_admin_password
# URL-safe base64 of exactly 32 random bytes; used only for Demo card PAN AES-GCM encryption.
CARD_ENCRYPTION_KEY=replace_with_urlsafe_base64_32_byte_key

# Agent LLM provider. Each developer supplies their own API key; never commit .env.
SILICONFLOW_API_KEY=replace_with_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2

# Durable Agent conversations. Defaults are suitable for the local competition demo.
AGENT_CONVERSATION_RETENTION_DAYS=30
AGENT_RUN_LEASE_SECONDS=300
AGENT_RUN_MAX_ATTEMPTS=3
AGENT_SSE_POLL_SECONDS=0.5
AGENT_SSE_MAX_SECONDS=25

# Private analysis policy (non-secret defaults). Exact data never enters model messages.
ANALYSIS_RETENTION_HOURS=24
ANALYSIS_MIN_SAMPLES=5
ANALYSIS_DAILY_SCOPE_LIMIT=10
# Relative to project root; local directory must be writable only by the service account.
# spending-bundle-v2: transaction/user_day/account_day; retrain old v1 artifacts with maintenance CLI
ANOMALY_MODEL_DIRECTORY=.runtime/anomaly-models
ANOMALY_MODEL_MAX_AGE_DAYS=90
